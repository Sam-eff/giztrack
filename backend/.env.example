# Django
SECRET_KEY=your-secret-key-here
DEBUG=False

# Database — SQLite for dev, Postgres for production/Docker
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://techshop_user:password@localhost:5432/techshop_db

# Background Tasks — Django Q2 (uses Django ORM by default, no Redis needed)
# To switch to Redis broker for higher throughput, uncomment and set REDIS_URL
# then update Q_CLUSTER in settings.py to use "redis" instead of "orm".
# REDIS_URL=redis://localhost:6379/0

# CORS / Hosts
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Frontend / Backend URLs (used in email links and Paystack callback)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Auth cookies
AUTH_COOKIE_ACCESS=tracknfix_access
AUTH_COOKIE_REFRESH=tracknfix_refresh
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_DOMAIN=
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SAMESITE=Lax
BOOTSTRAP_ADMIN_TOKEN=

# HTTPS / security headers
USE_HTTPS=False
# Local Django/Docker backend on :8000 may need this set to True.
# In production behind Nginx or object storage, leave this False.
SERVE_MEDIA=True
# SECURE_SSL_REDIRECT=True

# Cloudinary media storage (optional — local dev uses backend/media by default)
# USE_CLOUDINARY=True
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
# CLOUDINARY_FOLDER=giztrack

# Paystack
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_WEBHOOK_URL=https://your-domain.com/api/v1/subscriptions/webhook/

# Email (optional — defaults to console backend in dev)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=your@email.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=Giztrack <your@email.com>

# ── Africa's Talking (SMS) ────────────────────────────────────────────────────
# Sign up free at https://africastalking.com
# Use AT_USERNAME=sandbox + any AT_API_KEY value for free local testing
AT_API_KEY=your-api-key-here
AT_USERNAME=sandbox
AT_SENDER_ID=TracknFix  # Optional branded sender ID (requires AT approval)

# ── WhatsApp (Meta Cloud API) ─────────────────────────────────────────────────
# Sign up at https://developers.facebook.com → Create App → WhatsApp
# 1,000 free service conversations/month on production
WHATSAPP_ENABLED=False
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
