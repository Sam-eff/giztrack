SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False

DATABASE_URL=postgres://giztrack:replace-password@127.0.0.1:5432/giztrack_prod
Q_CLUSTER_WORKERS=2
Q_CLUSTER_TIMEOUT=120
Q_CLUSTER_RETRY=180
Q_CLUSTER_QUEUE_LIMIT=50
Q_CLUSTER_BULK=10

ALLOWED_HOSTS=api.your-domain.com
CORS_ALLOWED_ORIGINS=https://app.your-domain.com
CSRF_TRUSTED_ORIGINS=https://app.your-domain.com,https://api.your-domain.com

FRONTEND_URL=https://app.your-domain.com
BACKEND_URL=https://api.your-domain.com

AUTH_COOKIE_ACCESS=giztrack_access
AUTH_COOKIE_REFRESH=giztrack_refresh
AUTH_COOKIE_SECURE=True
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_DOMAIN=.your-domain.com
CSRF_COOKIE_DOMAIN=.your-domain.com
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_DOMAIN=.your-domain.com
SESSION_COOKIE_SAMESITE=Lax
BOOTSTRAP_ADMIN_TOKEN=

USE_HTTPS=True
SERVE_MEDIA=False
SECURE_SSL_REDIRECT=False
CLOUDINARY_CLOUD_NAME=replace_cloud_name
CLOUDINARY_API_KEY=replace_api_key
CLOUDINARY_API_SECRET=replace_api_secret
CLOUDINARY_FOLDER=giztrack
USE_CLOUDINARY=True

SENTRY_DSN=

PAYSTACK_SECRET_KEY=sk_live_replace_me
PAYSTACK_PUBLIC_KEY=pk_live_replace_me
PAYSTACK_WEBHOOK_URL=https://api.your-domain.com/api/v1/subscriptions/webhook/

# Resend HTTPS API
EMAIL_BACKEND=utils.email_backends.ResendEmailBackend
RESEND_API_KEY=re_replace_with_resend_api_key
DEFAULT_FROM_EMAIL=Giztrack <noreply@your-domain.com>

# Leave SMS disabled at launch if budget is tight.
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=
